{
  "name": "the-delegation",
  "description": "A no-code 3D playground to explore, design, and interact with Agentic AI systems",
  "license": "MIT",
  "author": "Arturo Paracuellos <arturo@unboring.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturitu/the-delegation.git"
  },
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,MEMORY -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "powershell -ExecutionPolicy Bypass -File ./scripts/start-memory-db.ps1 && tsx watch server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "share:url": "powershell -ExecutionPolicy Bypass -File ./scripts/share-lan-url.ps1",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:server": "tsx --test server/**/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "1.48.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.0",
    "three-pathfinding": "^1.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
